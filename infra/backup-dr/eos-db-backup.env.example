# Settings for eos-db-backup and eos-db-restore. install.sh copies this to /etc/eos/db-backup.env;
# edit that copy on the server. Every line is optional: these are the defaults.

# Where the app is checked out, and its compose and env files.
EOS_APP_DIR=/opt/education-os
EOS_COMPOSE_FILE=/opt/education-os/infra/docker/docker-compose.api.yml
EOS_ENV_FILE=/opt/education-os/infra/docker/.env.api

# Local backups: one dump per night, plus every Sunday's kept as a weekly.
EOS_BACKUP_DIR=/var/backups/eos
EOS_BACKUP_KEEP_DAILY=14
EOS_BACKUP_KEEP_WEEKLY=8

# A second location, so a lost disk does not take the backups with it. An rsync destination:
# a mounted folder (/mnt/backup/eos/) or another server over SSH (backup@<host>:/srv/eos-backups/).
# Empty: local copies only. The destination keeps the same dumps as the local folders: what is pruned
# here is deleted there on the same run (only eos-*/keycloak-* dumps; other files there are left alone).
EOS_BACKUP_OFFSITE=
# Most dumps one run may delete at the destination (a normal night rotates out at most four). A run that
# would delete more is refused and fails, so an emptied local folder cannot empty the destination. After
# lowering KEEP_DAILY or KEEP_WEEKLY on purpose, run once with EOS_BACKUP_OFFSITE_FORCE_PRUNE=1 in the
# environment (not here) to let the destination catch up.
EOS_BACKUP_OFFSITE_MAX_PRUNE=4
