# Settings for eos-monitor. install.sh copies this to /etc/eos/monitor.env (mode 600); edit that copy on the
# server. Every line is optional: these are the defaults.

# Where alerts go besides the journal (journalctl -t eos-monitor). Empty: the journal only. The URL is a
# secret (anyone holding it can post to the channel): it stays in this file, never in git.
#   Slack, Mattermost, Google Chat: the channel's incoming-webhook URL.
#   Telegram: https://api.telegram.org/bot<token>/sendMessage?chat_id=<chat id>
# Keep the double quotes: this file is read as shell, and a URL with `&` in it is cut without them.
EOS_MONITOR_WEBHOOK_URL=""
# Names this host in every alert, e.g. staging or production. Empty: the host name.
EOS_MONITOR_LABEL=
# While a check keeps failing, repeat its alert every this many minutes.
EOS_MONITOR_REMIND_MIN=60

# Where the app is checked out, and its compose and env files.
EOS_APP_DIR=/opt/education-os
EOS_COMPOSE_FILE=/opt/education-os/infra/docker/docker-compose.api.yml
EOS_ENV_FILE=/opt/education-os/infra/docker/.env.api

# The checks.
EOS_MONITOR_HEALTH_URL=http://127.0.0.1:8000/api/v1/health
# A failed health check is retried once after this many seconds (an auto-deploy restarts the API briefly).
EOS_MONITOR_HEALTH_RETRY_S=10
# Compose services that must be running (add keycloak kc-db when the oidc profile is on).
EOS_MONITOR_SERVICES="db api relay scheduler"
# The mark eos-db-backup writes after each successful backup, and its oldest allowed age. 0: no backup check.
EOS_MONITOR_BACKUP_MARK=/var/backups/eos/last-success
EOS_MONITOR_BACKUP_MAX_AGE_H=26
# Over the last WINDOW of the API's request log lines: alert above MAX_5XX answers with status 5xx, or above
# MAX_SLOW requests slower than SLOW_MS.
EOS_MONITOR_WINDOW=5m
EOS_MONITOR_MAX_5XX=5
EOS_MONITOR_SLOW_MS=2000
EOS_MONITOR_MAX_SLOW=10
EOS_MONITOR_DISK_PATH=/
EOS_MONITOR_DISK_MAX_PCT=85
# Longest wait for `docker compose ps` and `logs`; a hung daemon then fails the containers check.
EOS_MONITOR_DOCKER_TIMEOUT_S=20
