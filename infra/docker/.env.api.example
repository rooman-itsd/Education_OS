# Copy to infra/docker/.env.api on the Docker host and fill in. Never commit the real file.
EOS_DB_PASSWORD=
# The API's own database login (role eos_app, rows only, row-level security applies). EOS_DB_PASSWORD
# stays with the owner `eos`, which only the migrate step uses.
EOS_APP_DB_PASSWORD=
EOS_JWT_SECRET=
EOS_SUPER_ADMIN_EMAIL=
EOS_SUPER_ADMIN_PASSWORD=
EOS_DEV_MODE=false
EOS_CORS_ORIGINS=https://educationos.futureacad.ae
BILLING_PAYMENT_ADAPTER=none
EOS_API_PORT=8000

# platform/api-gateway (platform/api-gateway/README.md; the values below are the defaults).
# Emergency switch: set EOS_RATE_LIMIT_ENABLED=false here, then
#   docker compose -f infra/docker/docker-compose.api.yml --env-file infra/docker/.env.api up -d
EOS_RATE_LIMIT_ENABLED=true
EOS_SECURITY_HEADERS=true
# The reverse proxy whose X-Forwarded-For is believed: the nginx container's LAN address (PROXY_CTID in
# tools/scripts/deploy-api-lxc.sh, which fills this in), e.g. EOS_TRUSTED_PROXIES=<nginx container ip>.
# Required in production: left at loopback, every request counts against the proxy's one bucket.
EOS_TRUSTED_PROXIES=127.0.0.0/8,::1/128
EOS_RATE_LIMIT_IP_PER_MINUTE=1200
EOS_RATE_LIMIT_IP_BURST=1200
EOS_RATE_LIMIT_ORG_PER_MINUTE=3000
EOS_RATE_LIMIT_ORG_BURST=3000
EOS_RATE_LIMIT_AUTH_PER_MINUTE=60
EOS_RATE_LIMIT_AUTH_BURST=60
EOS_RATE_LIMIT_LOGIN_PER_MINUTE=10
EOS_RATE_LIMIT_LOGIN_BURST=10
EOS_HSTS_MAX_AGE=31536000
# Share the buckets between API processes (e.g. redis://redis:6379/0); empty: in each process.
EOS_REDIS_URL=
