# Copy to infra/docker/.env.api on the Docker host and fill in. Never commit the real file.
EOS_DB_PASSWORD=
# The API's own database login (role eos_app, rows only, row-level security applies). EOS_DB_PASSWORD
# stays with the owner `eos`, which only the migrate step uses.
EOS_APP_DB_PASSWORD=
EOS_JWT_SECRET=
EOS_SUPER_ADMIN_EMAIL=
EOS_SUPER_ADMIN_PASSWORD=
EOS_DEV_MODE=false
EOS_CORS_ORIGINS=https://educationos.futureacad.ae
BILLING_PAYMENT_ADAPTER=none
EOS_API_PORT=8000

# Keycloak, the OIDC provider (ADR-0006). Nothing below is needed until single sign-on is switched on.
# Set COMPOSE_PROFILES=oidc to start the keycloak and kc-db services; fill in the three secrets first
# (openssl rand -hex 24 for the two passwords is fine; the admin one is typed into the console).
COMPOSE_PROFILES=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# The public URL Keycloak answers on, including the /auth path the proxy forwards (KC_HTTP_RELATIVE_PATH).
KC_HOSTNAME=https://educationos.futureacad.ae/auth
# The address Keycloak's port is published on: the API host's LAN address, which the public proxy reaches
# (deploy-api-lxc.sh sets it). Empty or unset: 127.0.0.1, reachable from this host only.
KEYCLOAK_BIND=
KEYCLOAK_PORT=8080
KEYCLOAK_VERSION=26.0
# The API's side: the same public URL (realm issuers are <base>/realms/<slug>), the public client every realm
# holds, and the slugs whose realm exists (comma-separated, `*` for every organisation). Empty: OIDC off.
EOS_OIDC_ISSUER_BASE=
EOS_OIDC_CLIENT_ID=education-os-web
EOS_OIDC_REALMS=

# --- Mail. Optional while EOS_DEV_MODE=true (nothing is sent). With dev mode off, registration answers 503
# --- unless the adapter transport and an SMTP relay are set. The API and the relay both read these.
# NOTIFICATION_TRANSPORT=adapter
# NOTIFICATION_ADAPTER=messaging-providers
# NOTIFICATION_DEFAULT_FROM_EMAIL=no-reply@educationos.futureacad.ae
# NOTIFICATION_DEFAULT_FROM_NAME=Education OS
# MESSAGING_PROVIDERS_SMTP_HOST=
# MESSAGING_PROVIDERS_SMTP_PORT=587
# MESSAGING_PROVIDERS_SMTP_USE_TLS=true
# MESSAGING_PROVIDERS_SMTP_USERNAME=
# MESSAGING_PROVIDERS_SMTP_PASSWORD=
# MESSAGING_PROVIDERS_SMTP_TIMEOUT_S=10
# MESSAGING_PROVIDERS_FROM_EMAIL=no-reply@educationos.futureacad.ae
# MESSAGING_PROVIDERS_FROM_NAME=Education OS
# Longer than the whole SMTP exchange (about ten times the timeout above); raise it with the timeout.
# NOTIFICATION_SENDING_LEASE_S=120
