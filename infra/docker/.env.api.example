# Copy to infra/docker/.env.api on the Docker host and fill in. Never commit the real file.
EOS_DB_PASSWORD=
# The API's own database login (role eos_app, rows only, row-level security applies). EOS_DB_PASSWORD
# stays with the owner `eos`, which only the migrate step uses.
EOS_APP_DB_PASSWORD=
EOS_JWT_SECRET=
EOS_SUPER_ADMIN_EMAIL=
EOS_SUPER_ADMIN_PASSWORD=
EOS_DEV_MODE=false
EOS_CORS_ORIGINS=https://educationos.futureacad.ae
BILLING_PAYMENT_ADAPTER=none
EOS_API_PORT=8000
