# Environment variables consumed by api-gateway. These are host-level settings of apps/backend (its edge), so
# they carry the host's EOS_ prefix like EOS_CORS_ORIGINS; every value below is the default.

# Security headers on every response. Off only for local tooling that cannot cope with them; never in production.
EOS_SECURITY_HEADERS=true
# Strict-Transport-Security max-age in seconds (sent only when the request came in over HTTPS).
EOS_HSTS_MAX_AGE=31536000

# Rate limiting. The emergency switch: false in infra/docker/.env.api, then `docker compose ... up -d`, turns it
# off without a code change (README.md). Also off for test suites that hammer one address (apps/backend/tests).
EOS_RATE_LIMIT_ENABLED=true
# Token buckets: <scope>_PER_MINUTE is the sustained rate, <scope>_BURST how many may be served at once from a
# full bucket (defaults to the per-minute figure). A refused request answers 429 with Retry-After.
#   IP     per client address, requests without an organisation token. A campus behind one NAT address shares
#          it, so it is sized for a campus (1200 a minute is still 20 a second for one abusive client).
#   ORG    per organisation, from the `org` claim of a valid bearer token. Signed-in requests are charged here
#          only, not to their address, so a busy campus does not lock itself out.
#   AUTH   per client address for POST /identity/auth/login, POST /tenancy/register and every module's
#          /api/v1/<module>/public/... routes: 60 lets a lab of 40 sign in together, with room for typos.
#   LOGIN  per account and address (the email of a sign-in, stored as a digest, with the client address): 10
#          failed attempts a minute at one account from one address. Successful sign-ins do not count, and
#          another address has its own bucket, so nobody can lock an account's owner out. A lab (40 accounts,
#          one attempt each) never meets it.
EOS_RATE_LIMIT_IP_PER_MINUTE=1200
EOS_RATE_LIMIT_IP_BURST=1200
EOS_RATE_LIMIT_ORG_PER_MINUTE=3000
EOS_RATE_LIMIT_ORG_BURST=3000
EOS_RATE_LIMIT_AUTH_PER_MINUTE=60
EOS_RATE_LIMIT_AUTH_BURST=60
EOS_RATE_LIMIT_LOGIN_PER_MINUTE=10
EOS_RATE_LIMIT_LOGIN_BURST=10

# Peers whose X-Forwarded-For is believed (addresses or CIDRs, comma-separated). The chain is read from the right
# and the client is the first hop that is not one of these. Default: loopback only. In production set it to the
# reverse proxy's address as the API host sees it (the nginx container; deploy-api-lxc.sh writes it), or every
# request counts as the proxy's. Never a whole private range: anyone on it could forge the header and pick a
# fresh bucket per request. "*" makes every direct peer a proxy (only when the proxy is the sole way in).
# The proxy must pass X-Forwarded-For and X-Forwarded-Proto (infra/docker/nginx.public-vhost.conf does).
EOS_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Where the buckets live. Empty: in each API process (fine for one process). Set to share the counters between
# several API processes or replicas; the API fails open (allows, logs) while Redis is unreachable, and fast: a
# 0.1 s connect timeout, no retries, and Redis is left alone for 30 s after a failure.
EOS_REDIS_URL=
