# Environment variables consumed by scheduler. Prefix every key with the module name.

# Whether this process runs the scheduler loop. In the modular monolith one process owns it;
# set false on every other replica so a job does not fire once per replica.
SCHEDULER_ENABLED=true

# arq (the approved job runner) on Redis.
SCHEDULER_REDIS_URL=redis://localhost:6379/1

# How often the loop looks for schedules that are due. Jobs are scheduled to the minute, so
# there is nothing to gain from checking more often.
SCHEDULER_TICK_INTERVAL_S=30

# How long a handler has to confirm a run before it is marked failed. A job that legitimately
# runs longer should report progress rather than have this raised globally.
SCHEDULER_RUN_TIMEOUT_S=900

# Default catch-up policy for windows missed during an outage or deployment: once | never.
SCHEDULER_DEFAULT_CATCH_UP=once

# Oldest missed window still worth running on catch-up. Beyond this the window is recorded as
# skipped rather than run, so a long outage does not trigger a stampede on restart.
SCHEDULER_CATCH_UP_HORIZON_S=86400

# Timezone used only to display next_run_at when a schedule somehow has none. Schedules
# themselves must carry an explicit timezone; there is deliberately no default for them.
SCHEDULER_DISPLAY_TIMEZONE=UTC

# How long run history is kept. The permanent record of operator actions is platform/audit.
SCHEDULER_RUN_RETENTION_DAYS=90
