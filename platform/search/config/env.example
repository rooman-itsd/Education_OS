# Environment variables consumed by search. Prefix every key with the module name.

# Which engine answers. "memory" is the in-process fake behind the SearchEngine port: tests and dev
# mode use it, and it is refused when EOS_DEV_MODE is false (staging and production images set it
# false), so a deployed environment needs "opensearch".
SEARCH_ENGINE=memory

# OpenSearch connection, used when SEARCH_ENGINE=opensearch.
SEARCH_OPENSEARCH_URL=http://localhost:9200
SEARCH_OPENSEARCH_USER=
SEARCH_OPENSEARCH_PASSWORD=
SEARCH_OPENSEARCH_VERIFY_CERTS=true
SEARCH_OPENSEARCH_TIMEOUT_SECONDS=2

# Index names are eos-<environment>-<module>-<type>-v<n> behind an alias without the -v<n>.
# The environment keeps staging and production from sharing indexes on one cluster.
SEARCH_INDEX_ENVIRONMENT=dev

# Shards and replicas for a new index. One shard is plenty below a few million documents.
SEARCH_INDEX_SHARDS=1
SEARCH_INDEX_REPLICAS=1

# Query bounds. The API contract states the same numbers; lowering them is not a contract change.
SEARCH_MAX_QUERY_LENGTH=200
SEARCH_MAX_PAGE_SIZE=50
SEARCH_CURSOR_TTL_SECONDS=300

# Secret that signs cursors. Required outside dev mode.
SEARCH_CURSOR_SECRET=

# Reindex: documents per bulk request, and the most documents one job may write per second, so a
# backfill cannot starve queries.
SEARCH_REINDEX_BATCH_SIZE=500
SEARCH_REINDEX_MAX_DOCS_PER_SECOND=2000
