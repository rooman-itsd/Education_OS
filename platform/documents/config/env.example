# Environment variables consumed by documents. Prefix every key with the module name.
# Storage provider backend: 'minio' or 'memory' (default is 'memory' for tests/local dev)
DOCUMENTS_STORAGE_BACKEND=memory

# MinIO endpoint host:port (without http:// or https://)
DOCUMENTS_MINIO_ENDPOINT=localhost:9000

# MinIO authentication credentials
DOCUMENTS_MINIO_ACCESS_KEY=minioadmin
DOCUMENTS_MINIO_SECRET_KEY=minioadmin

# Set to true when MinIO uses TLS / HTTPS
DOCUMENTS_MINIO_SECURE=false

# Default S3 / MinIO bucket name for documents
DOCUMENTS_MINIO_BUCKET=eos-documents

# Maximum allowed file size in bytes (default: 50MB = 52428800)
DOCUMENTS_MAX_FILE_SIZE_BYTES=52428800

# Presigned upload and download URL expiry time in seconds (default: 900 = 15 minutes)
DOCUMENTS_URL_EXPIRES_SECONDS=900
