# Environment variables consumed by identity. Prefix every key with the module name.
# IDENTITY_FEATURE_ENABLED=true

# OpenID Connect through Keycloak (ADR-0006). Read by eos_core.oidc, which identity uses; the same values
# go into infra/docker/.env.api. Empty EOS_OIDC_ISSUER_BASE keeps OIDC off: only the API's own tokens count.
# The public base of Keycloak; every realm issuer is <base>/realms/<organisation slug>.
EOS_OIDC_ISSUER_BASE=
# The public client each realm holds (tools/scripts/keycloak-realm.sh); audience the API checks.
EOS_OIDC_CLIENT_ID=education-os-web
# Slugs whose realm exists, comma-separated, or `*` once every organisation gets one at approval.
EOS_OIDC_REALMS=
# How long a realm's signing keys are cached, the timeout of the code exchange, and the (shorter) timeout of
# the signing-key fetch, which runs inside a request.
EOS_OIDC_JWKS_TTL_SECONDS=3600
EOS_OIDC_HTTP_TIMEOUT=5
EOS_OIDC_JWKS_TIMEOUT=2
