# Environment variables consumed by notification. Prefix every key with the module name.

# Which transport actually sends. "memory" keeps messages in process and sends nothing: it is
# what tests and dev mode use, and it is refused when EOS_DEV_MODE is false (staging and production
# images set it false), so a deployed environment needs "adapter".
# "adapter" routes through an installed implementation of the OutboundMessaging port.
NOTIFICATION_TRANSPORT=memory

# Which installed adapter implements the port, by entry-point name in the group "eos.outbound_messaging".
# Notification never imports an adapter package: the adapter advertises itself and is selected here by name.
# The adapter must be installed (pip install -e integrations/messaging-providers) or the transport is a 503.
# Named explicitly on purpose: with several adapters installed, the first one is never chosen for you.
NOTIFICATION_ADAPTER=messaging-providers

# Channels that are switched on. Only email is implemented first; the others are contracted
# ahead so modules can be written against them.
NOTIFICATION_CHANNELS_ENABLED=email,in_app

# Default sender identity, overridable per organisation once branding lands.
NOTIFICATION_DEFAULT_FROM_EMAIL=no-reply@example.invalid
NOTIFICATION_DEFAULT_FROM_NAME=Education OS

# Fallback locale when the recipient has none and identity cannot supply one.
NOTIFICATION_DEFAULT_LOCALE=en

# Delivery retries before a message is marked failed and the failure event is raised.
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BACKOFF_S=30

# How long a claimed (`sending`) message is considered held by a worker before recovery may take it over.
# It must be longer than the WHOLE provider call, or a message still being sent loses its claim and is sent
# twice. Longer than the timeout alone is not enough: MESSAGING_PROVIDERS_SMTP_TIMEOUT_S (default 10) is a
# SOCKET timeout that applies to each blocking operation, and one SMTP send performs roughly ten of them
# (connect, EHLO, STARTTLS, EHLO, AUTH, MAIL FROM, RCPT TO, DATA, body, QUIT). The worst case is therefore
# about ten times that timeout: ~100s against this default of 120, which leaves little margin, and a raised
# provider timeout silently breaks the relationship because the two settings live in different modules and
# nothing correlates them. Raise this whenever you raise the provider timeout.
# Valid range 1..86400 seconds, clamped and logged like NOTIFICATION_RECOVERY_MAX_DELAY_S below: this value is
# added to and subtracted from the clock directly, so an unbounded one would raise mid-claim or mid-sweep.
NOTIFICATION_SENDING_LEASE_S=120

# When recovery itself fails on a message (a bug or a database error, not a provider failure), the message is
# deferred with a doubling delay: it starts at NOTIFICATION_RETRY_BACKOFF_S and is capped at
# NOTIFICATION_RECOVERY_MAX_DELAY_S. After NOTIFICATION_RECOVERY_MAX_FAILURES recovery failures the message is
# marked failed and notification.message.failed is published once.
NOTIFICATION_RECOVERY_MAX_FAILURES=5

# Valid range 1..86400 seconds (24 hours). A value outside it is clamped to the nearest end, not rejected, and
# the first out-of-range value for this setting is logged once -- a typo should not stop the service starting.
# Unparseable text falls back to 3600, as with every NOTIFICATION_* integer.
#
# The 24-hour ceiling is an operational limit on ONE configured delay, not a promise that every message is
# delivered within a day: NOTIFICATION_MAX_ATTEMPTS still bounds the attempts and an exhausted message becomes
# `failed`. The ceiling exists because this value is also the only bound on a provider's own retry hint. Left
# unbounded, a hostile hint would push next_attempt_at past the end of the calendar, and that overflow is
# raised after the message has already been claimed -- stranding it mid-send until recovery finds it.
NOTIFICATION_RECOVERY_MAX_DELAY_S=3600

# How long delivery history is kept. Bodies are not stored beyond this; the permanent record
# of what happened is platform/audit.
NOTIFICATION_HISTORY_RETENTION_DAYS=90

# Suppress an address after this many consecutive hard bounces, to protect sending reputation.
NOTIFICATION_HARD_BOUNCE_SUPPRESS_AFTER=1
