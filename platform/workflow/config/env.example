# Environment variables consumed by workflow. Prefix every key with the module name.
# Default SLA in hours for approval steps that set no sla_hours. A step past its deadline is escalated once
# (workflow.step.overdue) by the scheduled job workflow.sla-check (every 15 minutes by default).
WORKFLOW_DEFAULT_SLA_HOURS=48

# Maximum steps allowed per approval chain
WORKFLOW_MAX_STEPS=10

# Maximum page size for list and pending queries
WORKFLOW_MAX_PAGE_SIZE=100
