# Environment variables consumed by tenancy. Prefix every key with the module name.
# TENANCY_REGISTRATION_OPEN=true            # false = invite only
# TENANCY_AUTO_APPROVE=false                # true = skip super admin approval (dev only)
# TENANCY_DEFAULT_PLAN=trial
# TENANCY_VERIFY_TOKEN_TTL_HOURS=48
# TENANCY_RESERVED_SLUGS=admin,api,www,app
# Platform-wide key read by tenancy (shared with the host's deployment config, hence the EOS_ prefix):
# EOS_ORGANISATION_RETENTION_DAYS=30       # days an archived organisation's rows are kept before a purge may run
