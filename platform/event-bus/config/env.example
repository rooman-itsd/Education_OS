# Environment variables consumed by event-bus. Prefix every key with the module name.
# Defaults are the modular-monolith setup: no broker, no extra infrastructure.

# Which transport the relay delivers to. inprocess = subscribers in the same apps/backend
# process. A broker transport (redis-streams / rabbitmq / kafka) follows the broker ADR.
EVENT_BUS_TRANSPORT=inprocess

# Relay loop. Poll interval applies only when the outbox is empty.
EVENT_BUS_POLL_INTERVAL_MS=1000
EVENT_BUS_BATCH_SIZE=100

# Delivery attempts before an event is dead-lettered and stops being retried.
EVENT_BUS_MAX_ATTEMPTS=8

# Age of the oldest undelivered event, in seconds, that raises event-bus.relay.stalled.
EVENT_BUS_STALL_THRESHOLD_S=300

# How long delivered events are kept before pruning. The permanent record is platform/audit,
# not the outbox.
EVENT_BUS_RETENTION_DAYS=30
