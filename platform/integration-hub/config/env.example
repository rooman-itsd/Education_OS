# Environment variables consumed by integration-hub. Prefix every key with the module name.
#
# NEVER commit real values (team rule 10). The values below are placeholders or safe defaults.
# Adapters have their own config/env.example for their platform credentials and provider endpoints.

# Public base URL of the API. Provider callback URLs (/inbound/...) and the OAuth redirect URI
# (/oauth/callback/{adapter}) are built on it. Required outside development.
# INTEGRATION_HUB_PUBLIC_BASE_URL=https://api.example.invalid

# --- Secret store. Credentials and tokens live here, never in the database (docs/prd.md, "Credentials").
# file (default): one AES-256-GCM encrypted file per secret under INTEGRATION_HUB_SECRET_DIR, mode 0600.
# env: read-only, values from the environment; development only.
INTEGRATION_HUB_SECRET_BACKEND=file
INTEGRATION_HUB_SECRET_DIR=/var/lib/eos/integration-hub/secrets
# 32 random bytes, base64. Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
INTEGRATION_HUB_SECRET_KEK=replace-me-in-the-environment
# The previous key while rotating; secrets are re-encrypted under the new key, then this is emptied.
# INTEGRATION_HUB_SECRET_KEK_PREVIOUS=

# mock mode (recorded provider responses, no network) is refused unless this is true. Development and demo only.
INTEGRATION_HUB_ALLOW_MOCK=false

# --- OAuth (organisation connections and personal account links)
# Hosts the browser may be sent back to after authorising, comma separated.
# INTEGRATION_HUB_ALLOWED_RETURN_HOSTS=educationos.example.invalid
INTEGRATION_HUB_OAUTH_STATE_TTL_S=600
# Refresh a token this long before it expires.
INTEGRATION_HUB_TOKEN_REFRESH_LEAD_S=600

# --- Inbound (provider webhooks and provider requests)
INTEGRATION_HUB_INBOUND_MAX_BYTES=1048576
INTEGRATION_HUB_PROVIDER_REQUEST_TIMEOUT_S=10
INTEGRATION_HUB_INBOUND_RAW_RETENTION_DAYS=7

# --- Port calls
# A sync operation that takes longer fails with transport_unavailable.
INTEGRATION_HUB_SYNC_TIMEOUT_S=15
# The same idempotency key within this window returns the first delivery.
INTEGRATION_HUB_IDEMPOTENCY_WINDOW_DAYS=30

# --- Retries: exponential backoff with full jitter, retryable error codes only.
INTEGRATION_HUB_RETRY_MAX_ATTEMPTS=8
INTEGRATION_HUB_RETRY_BASE_S=30
INTEGRATION_HUB_RETRY_MAX_S=21600
# Deliveries queued on a disabled connection fail as not_configured after this long.
INTEGRATION_HUB_QUEUE_EXPIRY_HOURS=72

# --- Retention
# Encrypted input of an async operation, kept only to retry it.
INTEGRATION_HUB_DELIVERY_PAYLOAD_RETENTION_DAYS=30
# The delivery log rows (no payloads).
INTEGRATION_HUB_DELIVERY_LOG_RETENTION_DAYS=400

# --- Health
INTEGRATION_HUB_HEALTH_INTERVAL_MIN=15
INTEGRATION_HUB_HEALTH_RUNS_PER_HOUR=12

# Adapters the hub may load, comma separated. Empty: every adapter installed on the entry point group.
# INTEGRATION_HUB_ADAPTERS=
