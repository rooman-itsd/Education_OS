# Environment variables consumed by audit. Prefix every key with the module name.

# Retention. Records are never deleted individually; whole windows age out, and the floor
# cannot be lowered below what accreditation requires. Proposed default: 7 years.
AUDIT_RETENTION_DAYS=2555

# Pruning runs through platform/scheduler. Set false to keep everything forever.
AUDIT_RETENTION_ENABLED=true

# Maximum size of a single before/after payload, in bytes. Oversized payloads are rejected
# rather than truncated, so a record never silently lies about what changed.
AUDIT_MAX_PAYLOAD_BYTES=16384

# Page size ceiling for searches and exports.
AUDIT_MAX_PAGE_SIZE=200

# Tamper-evident hash chaining. Off in v1; see docs/prd.md open questions.
AUDIT_HASH_CHAIN_ENABLED=false
