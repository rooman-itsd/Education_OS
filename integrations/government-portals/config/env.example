# Environment variables consumed by government-portals. Prefix every key with the module name.
#
# NEVER commit real values (team rule 10). This adapter holds no portal credentials at all: an institution files on
# AISHE, NIRF and NAAC with its own nodal officer's login, which Education OS never stores (docs/prd.md, "Rules").
# Per-institution identifiers (AISHE code, NIRF institute id, NAAC HEI id) are settings on the integration-hub
# connection.

# Format cycle each authority's forms follow. A new cycle's format is a new adapter release; the adapter refuses to
# prepare a cycle it has no format for rather than reuse last year's.
GOVERNMENT_PORTALS_AISHE_FORMAT=2025-26
GOVERNMENT_PORTALS_NIRF_FORMAT=2026
GOVERNMENT_PORTALS_NAAC_FORMAT=2025

# Package limits. Evidence files over the per-file limit are flagged as issues, not silently compressed.
GOVERNMENT_PORTALS_MAX_EVIDENCE_FILE_BYTES=5242880
GOVERNMENT_PORTALS_MAX_PACKAGE_BYTES=524288000

# API channel per authority, for the day one opens an API to institutions. Empty: manual only.
# GOVERNMENT_PORTALS_AISHE_API_BASE_URL=
# GOVERNMENT_PORTALS_NIRF_API_BASE_URL=
# GOVERNMENT_PORTALS_NAAC_API_BASE_URL=
