# Environment variables consumed by digilocker. Prefix every key with the module name.
#
# NEVER commit real values (team rule 10). Per-institution credentials (issuer id, issuer API key, push client
# secret) are NOT here: each organisation enters them on its integration-hub connection, and they live in the hub's
# secret store. What is here is per deployment.

# Endpoints. Production per the Requester API Specification v1.12. Sandbox URLs are issued with sandbox access during
# onboarding (docs/prd.md, "Sandbox and mock"); until then a connection in sandbox mode cannot be enabled.
DIGILOCKER_LIVE_BASE_URL=https://api.digitallocker.gov.in/public
# DIGILOCKER_SANDBOX_BASE_URL=

# Rooman's requester (Authorised Partner) app, one per deployment: used to fetch documents a person consents to
# share (fetch_holder_document, list_holder_documents). PKCE S256; the redirect URI registered with DigiLocker is
# <INTEGRATION_HUB_PUBLIC_BASE_URL>/api/v1/integration-hub/oauth/callback/digilocker.
# DIGILOCKER_REQUESTER_CLIENT_ID=
# DIGILOCKER_REQUESTER_CLIENT_SECRET=
# DIGILOCKER_SANDBOX_REQUESTER_CLIENT_ID=
# DIGILOCKER_SANDBOX_REQUESTER_CLIENT_SECRET=
# Purpose sent with the authorize request: educational | verification.
DIGILOCKER_REQUESTER_PURPOSE=educational
# How long the person's consent lasts, in days; sent as consent_valid_till.
DIGILOCKER_CONSENT_DAYS=30

# Pull Issuer API (DigiLocker calls us): allowed clock skew on the request timestamp.
DIGILOCKER_PULL_TOLERANCE_S=300
# Push URI requests: DigiLocker refuses a ts older than 30 minutes; we sign with a fresh one, and refuse to send
# a request that took longer than this to build.
DIGILOCKER_PUSH_MAX_AGE_S=60
DIGILOCKER_HTTP_TIMEOUT_S=15
# Largest PDF served to DigiLocker.
DIGILOCKER_MAX_DOCUMENT_BYTES=5242880

# Keyed hash for the search keys of issued documents (roll number and year), so they cannot be recovered from the
# database by guessing. Required in sandbox and live mode; mock mode uses a fixed development value. Generate once per
# deployment (for example `openssl rand -hex 32`) and never change it while documents are issued, or pulls stop matching.
# DIGILOCKER_SEARCH_KEY_PEPPER=
