# Environment variables consumed by nad. Prefix every key with the module name.
#
# NEVER commit real values (team rule 10). Per-institution identifiers (NAD institution id, ABC institution id) and
# any API credentials NAD or ABC grant are entered on the organisation's integration-hub connection; secrets live in
# the hub's secret store. What is here is per deployment.

# API endpoints, once NAD and ABC grant API access (docs/prd.md, "External dependencies"). Empty: the API channel is
# off and every submission is prepared as the depository's upload file (manual_action_required).
# NAD_AWARDS_API_BASE_URL=
# NAD_AWARDS_SANDBOX_API_BASE_URL=
# NAD_ABC_API_BASE_URL=
# NAD_ABC_SANDBOX_API_BASE_URL=
# APAAR / ABC id verification, if offered to institutions through API Setu.
# NAD_APAAR_VERIFY_API_BASE_URL=

# Upload file format versions this deployment writes. Bumped when the depository changes its template; the adapter
# refuses an unknown version rather than writing a file the portal would reject.
NAD_AWARDS_CSV_TEMPLATE_VERSION=1
NAD_CREDITS_CSV_TEMPLATE_VERSION=1
# Largest batch per upload file; larger batches are split into several files.
NAD_MAX_ROWS_PER_FILE=5000
NAD_HTTP_TIMEOUT_S=30
