# Environment variables consumed by video-conferencing. Prefix every key with the module name.
#
# NEVER commit real values (team rule 10). These are Rooman's platform apps, one per deployment, which institutions
# authorise. An institution's own tokens, tenant id, Jitsi secret or own-app credentials are entered on its
# integration-hub connection and kept in the hub's secret store.

# --- Zoom: Rooman's Marketplace OAuth app (general app, account-level). Redirect URI:
# <INTEGRATION_HUB_PUBLIC_BASE_URL>/api/v1/integration-hub/oauth/callback/video-conferencing
VIDEO_CONFERENCING_ZOOM_API_BASE_URL=https://api.zoom.us/v2
VIDEO_CONFERENCING_ZOOM_OAUTH_BASE_URL=https://zoom.us/oauth
# VIDEO_CONFERENCING_ZOOM_CLIENT_ID=
# VIDEO_CONFERENCING_ZOOM_CLIENT_SECRET=
# Secret token of the app's event subscription, for x-zm-signature.
# VIDEO_CONFERENCING_ZOOM_WEBHOOK_SECRET_TOKEN=

# --- Microsoft Teams: Rooman's multi-tenant Microsoft Entra app (application permissions
# OnlineMeetings.ReadWrite.All, OnlineMeetingArtifact.Read.All, OnlineMeetingRecording.Read.All). Each tenant's admin
# consents and sets an application access policy (docs/prd.md).
VIDEO_CONFERENCING_TEAMS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
VIDEO_CONFERENCING_TEAMS_LOGIN_BASE_URL=https://login.microsoftonline.com
# VIDEO_CONFERENCING_TEAMS_CLIENT_ID=
# VIDEO_CONFERENCING_TEAMS_CLIENT_SECRET=
# Graph subscriptions for recordings last at most 3 days; renew this long before expiry.
VIDEO_CONFERENCING_TEAMS_SUBSCRIPTION_RENEW_LEAD_MIN=720

# --- Webex: Rooman's Webex integration (OAuth, admin-authorised meeting scopes).
VIDEO_CONFERENCING_WEBEX_API_BASE_URL=https://webexapis.com/v1
# VIDEO_CONFERENCING_WEBEX_CLIENT_ID=
# VIDEO_CONFERENCING_WEBEX_CLIENT_SECRET=

# --- Jitsi (self-hosted): nothing per deployment. Each organisation's connection names its Jitsi base URL and
# app id; the app secret is in the hub's secret store. Join tokens (JWT, HS256) live this long.
VIDEO_CONFERENCING_JITSI_TOKEN_TTL_S=7200

# Allowed clock skew on signed webhooks.
VIDEO_CONFERENCING_WEBHOOK_TOLERANCE_S=300
VIDEO_CONFERENCING_HTTP_TIMEOUT_S=15
# Fetch the attendance report this long after a meeting ends (providers finalise it with a delay).
VIDEO_CONFERENCING_ATTENDANCE_DELAY_MIN=15
