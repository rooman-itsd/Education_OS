# Environment variables consumed by messaging-providers. Prefix every key with the module name.
#
# NEVER commit real credentials (team rule 10). The values below are deliberately fake.
# Real values arrive as environment variables in the deployment.

# Which providers are active, in order of preference per channel.
MESSAGING_PROVIDERS_EMAIL=smtp
# MESSAGING_PROVIDERS_SMS=
# MESSAGING_PROVIDERS_WHATSAPP=

# --- smtp: the week-2 provider. Defaults point at a local mail catcher (MailHog), so a
# --- developer sends real-looking mail with no account anywhere.
MESSAGING_PROVIDERS_SMTP_HOST=localhost
MESSAGING_PROVIDERS_SMTP_PORT=1025
MESSAGING_PROVIDERS_SMTP_USERNAME=
MESSAGING_PROVIDERS_SMTP_PASSWORD=
MESSAGING_PROVIDERS_SMTP_USE_TLS=false
MESSAGING_PROVIDERS_SMTP_TIMEOUT_S=10

# Sending identity. Platform-level in v1; a per-organisation sending domain needs DNS
# verification per tenant and is a later feature.
MESSAGING_PROVIDERS_FROM_EMAIL=no-reply@example.invalid
MESSAGING_PROVIDERS_FROM_NAME=Education OS

# --- Inbound webhooks. The signing secret is how a receipt is proved genuine; a request that
# --- cannot be verified is rejected, never processed. Read by nothing yet: the webhook endpoint
# --- is declared in contracts/openapi.yaml but not built.
MESSAGING_PROVIDERS_WEBHOOK_SIGNING_SECRET=replace-me-in-the-environment
MESSAGING_PROVIDERS_WEBHOOK_TOLERANCE_S=300

# Operator test sends (POST /providers/{provider}/test) allowed per hour, so the endpoint cannot be
# used to send mail. Counted per process and reset on restart; refused attempts count too. 0 turns
# test sends off.
MESSAGING_PROVIDERS_TEST_SEND_PER_HOUR=10

# --- Later providers. Names only, so the shape is agreed before anyone needs them.
# MESSAGING_PROVIDERS_SES_REGION=
# MESSAGING_PROVIDERS_SES_ACCESS_KEY_ID=
# MESSAGING_PROVIDERS_SES_SECRET_ACCESS_KEY=
# MESSAGING_PROVIDERS_SENDGRID_API_KEY=
# MESSAGING_PROVIDERS_TWILIO_ACCOUNT_SID=
# MESSAGING_PROVIDERS_TWILIO_AUTH_TOKEN=
# MESSAGING_PROVIDERS_WHATSAPP_PHONE_NUMBER_ID=
# MESSAGING_PROVIDERS_WHATSAPP_ACCESS_TOKEN=

# --- Test-only: tests/test_live_smtp.py runs against a real server when EOS_LIVE_SMTP_HOST is
# --- set, and skips otherwise. The application never reads these, which is why they do not
# --- carry the module prefix. A password set here is a real credential: set it in your shell
# --- or a git-ignored file, never in this one.
# EOS_LIVE_SMTP_HOST=localhost
# EOS_LIVE_SMTP_PORT=1026
# EOS_LIVE_SMTP_USE_TLS=false
# EOS_LIVE_SMTP_TIMEOUT_S=15
# EOS_LIVE_SMTP_USERNAME=
# EOS_LIVE_SMTP_PASSWORD=
# EOS_LIVE_SMTP_TO=
