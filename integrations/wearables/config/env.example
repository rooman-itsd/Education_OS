# Environment variables consumed by wearables. Prefix every key with the module name.
#
# NEVER commit real values (team rule 10). These are Rooman's developer apps, one per provider and deployment. Each
# athlete authorises them for their own account; their tokens are kept in integration-hub's secret store. Every
# redirect URI is <INTEGRATION_HUB_PUBLIC_BASE_URL>/api/v1/integration-hub/oauth/callback/wearables and every
# notification URL <INTEGRATION_HUB_PUBLIC_BASE_URL>/api/v1/integration-hub/inbound/wearables?provider=<provider>.

# --- Garmin Connect Developer Program (Health and Activity APIs), OAuth 2.0 with PKCE. Business approval required.
# WEARABLES_GARMIN_CLIENT_ID=
# WEARABLES_GARMIN_CLIENT_SECRET=
WEARABLES_GARMIN_AUTHORIZE_URL=https://connect.garmin.com/oauth2Confirm
WEARABLES_GARMIN_TOKEN_URL=https://connectapi.garmin.com/di-oauth2-service/oauth/token
WEARABLES_GARMIN_API_BASE_URL=https://apis.garmin.com

# --- Polar AccessLink v3, OAuth 2.0. Client created at admin.polaraccesslink.com.
# WEARABLES_POLAR_CLIENT_ID=
# WEARABLES_POLAR_CLIENT_SECRET=
# Returned once when the webhook is created; verifies Polar-Webhook-Signature.
# WEARABLES_POLAR_WEBHOOK_SIGNATURE_KEY=
WEARABLES_POLAR_AUTHORIZE_URL=https://flow.polar.com/oauth2/authorization
WEARABLES_POLAR_TOKEN_URL=https://polarremote.com/v2/oauth2/token
WEARABLES_POLAR_API_BASE_URL=https://www.polaraccesslink.com/v3

# --- Fitbit devices through the Google Health API (the legacy Fitbit Web API is shut down). Restricted scopes:
# Google's verification required before any athlete outside the test users can link.
# WEARABLES_GOOGLE_HEALTH_CLIENT_ID=
# WEARABLES_GOOGLE_HEALTH_CLIENT_SECRET=
# WEARABLES_GOOGLE_HEALTH_API_BASE_URL=

# --- Strava API v3, OAuth 2.0 (scope activity:read_all). One push subscription per app.
# WEARABLES_STRAVA_CLIENT_ID=
# WEARABLES_STRAVA_CLIENT_SECRET=
# Our own random string, echoed by Strava in the subscription handshake.
# WEARABLES_STRAVA_VERIFY_TOKEN=
# WEARABLES_STRAVA_SUBSCRIPTION_ID=
WEARABLES_STRAVA_API_BASE_URL=https://www.strava.com/api/v3

# --- Behaviour
# Keep normalised records this long; older records are deleted. Revoking a link deletes its records at once.
WEARABLES_RETENTION_DAYS=730
# History asked for when an athlete links, where the provider and tier allow it.
WEARABLES_DEFAULT_BACKFILL_DAYS=30
# An athlete with an active link and no data for this long shows as no_recent_data.
WEARABLES_STALE_AFTER_DAYS=3
WEARABLES_HTTP_TIMEOUT_S=15
