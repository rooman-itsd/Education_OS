# Environment variables consumed by external-university-portals. Prefix every key with the module name.
#
# NEVER commit real values (team rule 10). Partner institutions are integration-hub connections, not configuration here:
# partner_id, name, country, institution_code, formats_out, formats_in, channel, email, portal_url, csv_mapping,
# grade_conversion and credit_conversion are the connection's non-secret settings (see describe() and README).
# This release reads no secret: signing keys are not used (signed exports are not in this release).
# There is no mode switch here: the hub's connection mode decides. mock and sandbox write and read files but deliver
# nothing; only live emails the download link.

# How long the download link in an email to a partner stays valid (hours, 1 to 2160). Default one week.
EXTERNAL_UNIVERSITY_PORTALS_LINK_TTL_HOURS=168

# The largest partner file import_records will read (bytes, 1024 to 104857600). Default 10 MiB.
EXTERNAL_UNIVERSITY_PORTALS_MAX_IMPORT_BYTES=10485760

# DPDP Act 2023: countries (ISO 3166-1 alpha-2, comma separated) the Government of India restricts by notification.
# A partner whose country is listed gets no export and no delivery. Empty: none restricted.
# EXTERNAL_UNIVERSITY_PORTALS_RESTRICTED_COUNTRIES=
