# Environment variables consumed by external-university-portals. Prefix every key with the module name.
#
# NEVER commit real values (team rule 10). Partners are integration-hub connections, one per partner institution;
# their settings (formats, channel, address, grade conversion) and any signing key live there and in the hub's secret
# store. What is here is per deployment.

# Format versions written and read. A partner on another version is refused, not guessed. Pinned at build time to the
# current releases of github.com/emrex-eu/elmo-schemas and the Europass EDC / European Learning Model profile.
# EXTERNAL_UNIVERSITY_PORTALS_ELMO_SCHEMA_VERSION=
# EXTERNAL_UNIVERSITY_PORTALS_EDC_PROFILE_VERSION=
# How long an emailed download link to a partner stays valid.
EXTERNAL_UNIVERSITY_PORTALS_LINK_TTL_HOURS=168
# Largest file accepted for import.
EXTERNAL_UNIVERSITY_PORTALS_MAX_IMPORT_BYTES=10485760
