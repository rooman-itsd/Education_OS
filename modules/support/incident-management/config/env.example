# Environment variables consumed by incident-management. Prefix every key with the module name.
# INCIDENT_MANAGEMENT_FEATURE_ENABLED=true
# Prefix of the per-organisation incident number, such as INC-000123.
INCIDENT_MANAGEMENT_INCIDENT_NUMBER_PREFIX=INC
# Prefix of the per-organisation problem number, such as PRB-000045.
INCIDENT_MANAGEMENT_PROBLEM_NUMBER_PREFIX=PRB
