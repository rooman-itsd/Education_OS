# Environment variables consumed by amc-vendor-support. Prefix every key with the module name.
# AMC_VENDOR_SUPPORT_FEATURE_ENABLED=true
# Prefix of the per-organisation contract number, such as AMC-000012.
AMC_VENDOR_SUPPORT_CONTRACT_NUMBER_PREFIX=AMC
# Prefix of the per-organisation engagement number, such as AVS-000034.
AMC_VENDOR_SUPPORT_ENGAGEMENT_NUMBER_PREFIX=AVS
# Days ahead GET /stats/contracts-expiring looks when no within_days is given.
AMC_VENDOR_SUPPORT_EXPIRY_WINDOW_DAYS=60
# Currency used when a contract value gives none (ISO 4217).
AMC_VENDOR_SUPPORT_DEFAULT_CURRENCY=INR
