# Environment variables consumed by knowledge-base. Prefix every key with the module name.
# KNOWLEDGE_BASE_FEATURE_ENABLED=true
# Months after publication before an article's review_by date, when the editor sets none.
KNOWLEDGE_BASE_DEFAULT_REVIEW_MONTHS=12
# Articles returned by GET /stats/top-articles when no limit is given.
KNOWLEDGE_BASE_TOP_ARTICLES_LIMIT=10
# Fewest votes an article needs to be ranked by helpful share.
KNOWLEDGE_BASE_HELPFUL_MIN_VOTES=5
