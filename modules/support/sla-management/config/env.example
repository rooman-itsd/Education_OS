# Environment variables consumed by sla-management. Prefix every key with the module name.
# SLA_MANAGEMENT_FEATURE_ENABLED=true
# Warning threshold, as a percent of the target used, for policies that do not set their own.
SLA_MANAGEMENT_DEFAULT_WARNING_PERCENT=75
# Most escalation levels a policy may have.
SLA_MANAGEMENT_MAX_ESCALATION_LEVELS=3
# Most overdue clocks returned by GET /stats/breaches when no limit is given.
SLA_MANAGEMENT_BREACH_LIST_LIMIT=10
