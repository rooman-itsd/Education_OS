# Environment variables consumed by helpdesk. Prefix every key with the module name.
# HELPDESK_FEATURE_ENABLED=true
# Days after resolution before the daily job closes a ticket the requester has not confirmed.
HELPDESK_AUTO_CLOSE_DAYS=7
# Days after resolution during which the requester may reopen a ticket.
HELPDESK_REOPEN_WINDOW_DAYS=7
# Prefix of the per-organisation ticket number, such as HD-000123.
HELPDESK_TICKET_NUMBER_PREFIX=HD
# Maximum attachments on one ticket or reply.
HELPDESK_MAX_ATTACHMENTS=5
