# Environment variables consumed by transport. Prefix every key with the module name.
# TRANSPORT_FEATURE_ENABLED=true
# Days before a vehicle or driver document expires that the daily job publishes transport.document.expiry-flagged.
TRANSPORT_DOCUMENT_EXPIRY_NOTICE_DAYS=30
# Days live positions are kept before the daily job purges them.
TRANSPORT_POSITION_RETENTION_DAYS=30
