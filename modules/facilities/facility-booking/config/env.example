# Environment variables consumed by facility-booking. Prefix every key with the module name.
# Organisation-wide defaults; a resource type or resource may override the booking rules.
FACILITY_BOOKING_MAX_DAYS_AHEAD=90
FACILITY_BOOKING_DEFAULT_SLOT_MINUTES=30
FACILITY_BOOKING_NO_SHOW_GRACE_MINUTES=15
FACILITY_BOOKING_MAX_SERIES_OCCURRENCES=52
FACILITY_BOOKING_REMINDER_MINUTES_BEFORE=60
FACILITY_BOOKING_TIMEZONE=UTC
# IANA time zone of the organisation for opening hours and "today", e.g. Asia/Kolkata. On Windows install tzdata for non-UTC zones.
