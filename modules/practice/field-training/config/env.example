# Environment variables consumed by field-training. Prefix every key with the module name.
# FIELD_TRAINING_FEATURE_ENABLED=true
# The module reads no other key: business dates are Asia/Kolkata (fixed offset), the final assessment is due 7 days
# before a placement ends (contract), and the daily start job (eos_field_training.application.jobs.run_daily) runs
# once a day after midnight Asia/Kolkata on platform/scheduler's timer.
