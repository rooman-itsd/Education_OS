# Environment variables consumed by productions. Prefix every key with the module name.
# How far ahead the calendar widget looks when the caller gives no window, in days.
PRODUCTIONS_CALENDAR_WINDOW_DAYS=60
# How many preparation days a production is expected to have; scheduling it closer warns but does not refuse.
PRODUCTIONS_MIN_PREPARATION_DAYS=7
# Longest a single production may run, in hours. A longer window is refused as a typo.
PRODUCTIONS_MAX_RUN_HOURS=72
# How long before the start cast and crew are called, in minutes, when no call time is given.
PRODUCTIONS_DEFAULT_CALL_MINUTES=60
