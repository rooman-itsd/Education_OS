# Environment variables consumed by timetable-attendance. Prefix every key with the module name.
# TIMETABLE_ATTENDANCE_FEATURE_ENABLED=true
# Minutes before a class starts when its attendance session may be opened (docs/prd.md FR-7).
TIMETABLE_ATTENDANCE_MARKING_OPENS_BEFORE_MINUTES=15
# Hours after a class ends during which attendance may be marked; open sessions close automatically after it (FR-7, FR-11).
TIMETABLE_ATTENDANCE_MARKING_WINDOW_HOURS=24
# Days after a session closes during which its instructor may correct records (FR-10).
TIMETABLE_ATTENDANCE_CORRECTION_WINDOW_DAYS=7
# Attendance percentage below which a student is flagged as short (FR-13, FR-14). Per-organisation override is open question Q5.
TIMETABLE_ATTENDANCE_SHORTAGE_THRESHOLD_PERCENT=75
