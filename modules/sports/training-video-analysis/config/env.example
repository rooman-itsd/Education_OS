# Environment variables consumed by training-video-analysis. Prefix every key with the module name.
# The institution's offset from UTC (+HH:MM or -HH:MM). A session's day (inside its plan's dates, and the from_date /
# to_date filters of the session list) is the local date of its start at this offset. Times are stored and returned
# in UTC. A fixed offset does not follow daylight-saving changes.
TRAINING_VIDEO_ANALYSIS_UTC_OFFSET=+05:30
