# Environment variables consumed by tournament-events. Prefix every key with the module name.
# The institution's local timezone. Tournament dates (start, end, registration deadline) are local dates: a
# tournament is ongoing from its start_date and completed after its end_date in this timezone, and a fixture's
# scheduled_at (UTC) must fall on one of the tournament's local days. Date filters (from/to) are local days too.
TOURNAMENT_EVENTS_TIMEZONE=Asia/Kolkata
