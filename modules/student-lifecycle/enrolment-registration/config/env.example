# Environment variables consumed by enrolment-registration. Prefix every key with the module name.
# The module also uses the host's shared settings (EOS_DATABASE_URL, EOS_JWT_SECRET).

# Prefix of roll numbers: <PREFIX><YEAR>-<5 digits>, e.g. RN2026-00042. Numbered per organisation and year.
ENROLMENT_REGISTRATION_ROLL_NUMBER_PREFIX=RN

# Tests only: a PostgreSQL server for backend/tests/test_rls_postgres.py, as a user with CREATEDB and CREATEROLE.
# The test creates and drops its own throwaway database and role. Never point this at a real database.
# Unset, the two live row-level-security tests are skipped.
# ENROLMENT_REGISTRATION_TEST_POSTGRES_URL=postgresql+psycopg://user:password@localhost:5432/postgres
