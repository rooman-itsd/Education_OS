# Environment variables consumed by admissions. Prefix every key with the module name.
# The module also uses the host's shared settings (EOS_DATABASE_URL, EOS_JWT_SECRET); it adds none of its own for those.

# Prefix of generated application reference numbers: <PREFIX>-<YEAR>-<6 hex>, e.g. ADM-2026-A1B2C3.
ADMISSIONS_REFERENCE_PREFIX=ADM
# How many new reference numbers to try when one is already taken in the organisation before giving up (503).
ADMISSIONS_REFERENCE_COLLISION_RETRIES=3

# Tests only: a PostgreSQL server for backend/tests/test_rls_postgres.py, as a user with CREATEDB and CREATEROLE.
# The test creates and drops its own throwaway database and role. Never point this at a real database.
# Unset, the two live row-level-security tests are skipped.
# ADMISSIONS_TEST_POSTGRES_URL=postgresql+psycopg://user:password@localhost:5432/postgres
