# Environment variables consumed by student-information. Prefix every key with the module name.
# Feature toggle
STUDENT_INFORMATION_FEATURE_ENABLED=true

# Card issuance configuration
# Prefix for generated ID card numbers (IDC-{ORG4}-{YYYYMM}-{RANDOM6})
STUDENT_INFORMATION_CARD_NUMBER_PREFIX=IDC
# Maximum retry attempts when generating unique ID card numbers
STUDENT_INFORMATION_CARD_COLLISION_RETRIES=3

# Testing & Database
# Dedicated PostgreSQL instance URL for running row-level security (RLS) test suite
STUDENT_INFORMATION_TEST_POSTGRES_URL=postgresql+psycopg://eos:eos@localhost:5432/eos
