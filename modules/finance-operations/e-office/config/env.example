# Environment variables consumed by e-office. Prefix every key with the module name.
E_OFFICE_FEATURE_ENABLED=true
# Days a file may stay with one holder before it counts as overdue, when no due date was set on forwarding, by
# priority. Counted in Indian business dates (Asia/Kolkata) from the date the holder received it; overdue from the day
# after. Whole days from 0 to 365; an unset or unreadable value falls back to the default shown here.
E_OFFICE_DEFAULT_DUE_DAYS_NORMAL=7
E_OFFICE_DEFAULT_DUE_DAYS_URGENT=2
E_OFFICE_DEFAULT_DUE_DAYS_IMMEDIATE=1
