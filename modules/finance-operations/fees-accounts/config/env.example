# Environment variables consumed by fees-accounts. Prefix every key with the module name.
FEES_ACCOUNTS_FEATURE_ENABLED=true
FEES_ACCOUNTS_CURRENCY=INR
# Absolute base URL of the payment adapter API, e.g. https://api.example.com/api/v1/payment-sbiepay.
# Empty: online payment answers 503 and dues show can_pay_online=false.
FEES_ACCOUNTS_PAYMENT_ADAPTER_URL=
# Where the payer's browser returns after paying online (its host must be allowed by the adapter).
FEES_ACCOUNTS_PAYMENT_RETURN_URL=
# Prefixes for organisation-wide sequential numbers.
FEES_ACCOUNTS_INVOICE_NUMBER_PREFIX=INV
FEES_ACCOUNTS_RECEIPT_NUMBER_PREFIX=RCT
# Days before a due date when a reminder is sent, comma separated (used by notification once it consumes events).
FEES_ACCOUNTS_DUE_REMINDER_DAYS=7,1
# Largest number of people in one bulk invoice request.
FEES_ACCOUNTS_BULK_INVOICE_MAX=5000
# First month of the academic year (1-12); collection targets and the default year follow it.
FEES_ACCOUNTS_ACADEMIC_YEAR_START_MONTH=6
# Days a library fine invoice is due after it is raised (when the organisation invoices fines).
FEES_ACCOUNTS_FINE_DUE_DAYS=15
