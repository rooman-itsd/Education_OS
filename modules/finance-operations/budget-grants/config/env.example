# Environment variables consumed by budget-grants. Prefix every key with the module name.
BUDGET_GRANTS_FEATURE_ENABLED=true
BUDGET_GRANTS_CURRENCY=INR
# First month of the financial year (4 = April). Budgets, the payroll charge and the report default follow it.
BUDGET_GRANTS_FINANCIAL_YEAR_START_MONTH=4
# Percentages of a line's allocation at which budget-grants.line.threshold-reached is published, once each.
BUDGET_GRANTS_ALERT_PERCENTS=80,100
# Budget head code that hr-payroll.payroll-run.paid is charged to in the institution-wide budget.
BUDGET_GRANTS_SALARY_BUDGET_HEAD_CODE=SALARIES
# Days before a utilisation certificate is due when budget-grants.utilisation-certificate.due is published.
BUDGET_GRANTS_UC_REMINDER_DAYS=30,7
