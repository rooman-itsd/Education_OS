# Environment variables consumed by procurement. Prefix every key with the module name.
PROCUREMENT_FEATURE_ENABLED=true
PROCUREMENT_CURRENCY=INR
# Absolute base URL of the budget-grants API, e.g. https://api.example.com/api/v1/budget-grants. Indent approval calls
# GET /availability there with the approver's token. Unset or unreachable: approval answers 503 budget_check_unavailable.
PROCUREMENT_BUDGET_GRANTS_URL=
# Purchase method by estimated value: up to the direct limit = direct purchase, up to the quotation limit =
# quotations, above it = tender. Set from the institution's purchase rules; there is no default. Until both are set,
# indent approval answers 422 purchase_limits_not_configured.
PROCUREMENT_DIRECT_PURCHASE_LIMIT=
PROCUREMENT_QUOTATION_LIMIT=
# Allowed difference between what is invoiced on an order and the accepted value of its receipts, in percent.
PROCUREMENT_INVOICE_MATCH_TOLERANCE_PERCENT=0
