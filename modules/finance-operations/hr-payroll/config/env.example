# Environment variables consumed by hr-payroll. Prefix every key with the module name.
# Read on every request; an unreadable or out-of-range value falls back to its default.
# Whether the host mounts the module (read by the host's modules.enabled.yaml tooling, not by the module).
HR_PAYROLL_FEATURE_ENABLED=true
# Currency of every amount; only INR is supported (amounts are rupees with paise).
HR_PAYROLL_CURRENCY=INR
# First month of the leave year (1 = January, 4 = April). Entitlements, carry-forward and "one leave year per
# request" follow it. 1 to 12; default 1.
HR_PAYROLL_LEAVE_YEAR_START_MONTH=1
# Day of the month by which the payroll run should be approved; the run's `late` flag (and the dashboard) turn on after
# it. Kept inside the month (28 in February when set to 30). 1 to 31; default 28.
HR_PAYROLL_PAYROLL_DUE_DAY=28
# Alembic chain of hr-payroll: own tables only, own version table (hr_payroll_alembic_version).
#   cd modules/finance-operations/hr-payroll/db && alembic upgrade head
# The database URL comes from EOS_DATABASE_URL (same as the app), or `alembic -x url=... upgrade head`.
