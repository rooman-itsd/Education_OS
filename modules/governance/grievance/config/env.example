# Environment variables consumed by grievance. Prefix every key with the module name.
# GRIEVANCE_FEATURE_ENABLED=true
# Prefix of the per-organisation case number, such as GRV-000123.
GRIEVANCE_CASE_NUMBER_PREFIX=GRV
# Due-date settings per track. They are the organisation's to set, not legal values, and have no default until
# docs/prd.md open question 1 is settled. With no value, a case has no due date.
GRIEVANCE_STUDENT_GRIEVANCE_ACKNOWLEDGE_DAYS=
GRIEVANCE_STUDENT_GRIEVANCE_DECIDE_DAYS=
GRIEVANCE_RAGGING_ACKNOWLEDGE_DAYS=
GRIEVANCE_RAGGING_DECIDE_DAYS=
GRIEVANCE_SEXUAL_HARASSMENT_ACKNOWLEDGE_DAYS=
GRIEVANCE_SEXUAL_HARASSMENT_DECIDE_DAYS=
# Days after an SGRC decision during which the complainant may appeal; empty until open question 1 is settled.
# While empty, appeals are refused with "Appeal window is not configured".
GRIEVANCE_APPEAL_WINDOW_DAYS=
# calendar or working; empty until open question 1 is settled.
GRIEVANCE_DAY_COUNTING=
