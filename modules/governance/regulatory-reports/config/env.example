# Environment variables consumed by regulatory-reports. Prefix every key with the module name.
# REGULATORY_REPORTS_FEATURE_ENABLED=true
# Days ahead a filing counts as due soon in GET /stats/due. A widget threshold, not a legal value.
REGULATORY_REPORTS_DUE_SOON_DAYS=30
# Longest date range GET /calendar returns.
REGULATORY_REPORTS_CALENDAR_MAX_DAYS=366
