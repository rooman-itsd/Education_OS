# Environment variables consumed by rti. Prefix every key with the module name.
# RTI_FEATURE_ENABLED=true
# Prefix of the per-organisation request number, such as RTI-000045.
RTI_REQUEST_NUMBER_PREFIX=RTI
# Currency used when a fee amount gives none (ISO 4217).
RTI_DEFAULT_CURRENCY=INR
# Days ahead GET /stats/nearing-deadline looks. A widget threshold, not a legal value.
RTI_NEARING_DEADLINE_DAYS=7
# Timeline settings. They are the organisation's to set, not legal values, and have no default until docs/prd.md open
# question 1 is settled. With no value there is no due date.
RTI_RESPONSE_DAYS=
# Days after the response during which a first appeal can be recorded. While empty, appeals are refused with
# "Appeal window is not configured" and responded requests stay responded.
RTI_APPEAL_WINDOW_DAYS=
RTI_APPEAL_DECIDE_DAYS=
# calendar or working; empty until open question 1 is settled.
RTI_DAY_COUNTING=
